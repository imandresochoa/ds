{
  "name": "@imandresochoa/ds",
  "version": "0.8.0",
  "private": true,
  "license": "MIT",
  "description": "Kit para crear sistemas de diseño agentic-first enlazados 1:1 con producción.",
  "keywords": [
    "design-system",
    "agentic",
    "agents",
    "claude-code",
    "codex",
    "skills",
    "shadcn"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imandresochoa/ds.git"
  },
  "type": "module",
  "bin": {
    "ds": "bin/ds.mjs"
  },
  "files": [
    "app",
    "bin",
    "components",
    "docs/metodologia",
    "lib",
    "plantilla",
    "scripts",
    "skills",
    "systems/ejemplo",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "predev": "node scripts/build-public.mjs",
    "dev": "next dev --port 4100",
    "prebuild": "node scripts/build-public.mjs --exportar",
    "build": "next build",
    "sync": "node scripts/sync-production.mjs",
    "check:sync": "node scripts/sync-production.mjs --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.9.0",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.29",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
